# Copy this file to backend/.env and fill in your real values.
# backend/.env is gitignored -- never commit it.

# REQUIRED for Step 4+ (get from https://aistudio.google.com/apikey -- free tier)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model id. Default: gemini-3.1-flash-lite (GA).
# Newer alternative (GA July 2026): gemini-3.5-flash-lite
# GEMINI_MODEL=gemini-3.1-flash-lite

# REQUIRED for Step 7 (Razorpay TEST mode keys, from dashboard.razorpay.com)
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx
